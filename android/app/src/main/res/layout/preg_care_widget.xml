<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFBFB">

    <TextView
        android:id="@+id/widget_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#241C24"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Mira" />

    <TextView
        android:id="@+id/widget_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7A7280"
        android:textSize="12sp"
        android:text="Week —" />

    <TextView
        android:id="@+id/widget_water"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#241C24"
        android:textSize="14sp"
        android:text="0 ml" />

    <TextView
        android:id="@+id/widget_visit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#241C24"
        android:textSize="13sp"
        android:text="No visit" />
</LinearLayout>
